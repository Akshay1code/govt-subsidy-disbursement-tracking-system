# ─── Root-level .gitignore ────────────────────────────────────────────────────
# Covers the whole monorepo. Language/tool-specific rules live in
# backend/.gitignore and frontend/.gitignore respectively.

# IDE & editors
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sw?
*.swp

# macOS / Windows system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary test scripts at the root
*.log
test-api.js
*.test.js

# Environment secrets (never commit these)
.env
.env.*
!.env.example

# OS-generated
ehthumbs.db
